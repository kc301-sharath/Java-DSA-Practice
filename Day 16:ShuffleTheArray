class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] result = new int[2 * n];
        int[] left = new int[n];
        for (int i = 0; i < n; i++) {
            left[i] = nums[i];
        }
        int i = 0;
        while (i < n) {
            result[2 * i] = left[i];
            result[2 * i + 1] = nums[i + n];

            i++;
        }
        return result;

    }
}
